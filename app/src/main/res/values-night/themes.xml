<resources>
    <!-- Existing screens have light surfaces. Keep one readable palette until a full dark theme exists. -->
    <style name="Theme.Gourmeet2" parent="Base.Theme.Gourmeet2">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Base.Theme.Gourmeet2" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
