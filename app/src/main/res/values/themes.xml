<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Gourmeet2" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bottom_nav_color</item>
        <item name="colorPrimaryVariant">@color/bottom_nav_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bottom_nav_color</item>
        <!-- Customize your theme here. -->
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.Gourmeet2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
    <style name="TemaRelojGourMeet" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <!-- Fondo blanco -->
        <item name="android:colorBackground">@android:color/white</item>

        <!-- Azul GourMeet para los elementos de selección -->
        <item name="colorAccent">@color/azulgourmeet</item>

        <!-- Texto oscuro/azul -->
        <item name="android:textColorPrimary">@color/azulgourmeet</item>
        <item name="android:textColorSecondary">@color/azulgourmeet</item>

        <!-- Botones de confirmación y cancelación -->
        <item name="colorControlActivated">@color/azulgourmeet</item>
        <item name="colorControlHighlight">@color/azulgourmeet</item>
    </style>
</resources>