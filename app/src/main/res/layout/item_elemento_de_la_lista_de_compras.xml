<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/contenedordelingrediente"
        android:layout_width="170dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <EditText
            android:id="@+id/txtCantidadIngrediente"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circulo_azul"
            android:textSize="18sp"
            android:text="200ml"
            android:fontFamily="@font/caviardreams"
            android:textColor="@color/white"
            android:gravity="center"
            android:padding="0dp"
            android:singleLine="true"
            android:inputType="text" />
        <TextView
            android:id="@+id/txtNombreIngrediente"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Tomate"
            android:gravity="center_vertical"
            android:textColor="@color/azulgourmeet"
            android:fontFamily="@font/caviardreams"
            android:textSize="14sp"
            android:paddingStart="6dp"
            android:maxLines="2" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>