<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="440dp"
    android:layout_marginTop="30dp"

    android:orientation="vertical"
    android:background="@color/white"
    android:elevation="20dp">

    <!-- ===================================== -->
    <!-- INDICADOR PARA ARRASTRAR -->
    <!-- ===================================== -->

    <View
        android:id="@+id/indicadorFiltro"
        android:layout_width="45dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_arrastre_rectangulo"/>


    <!-- ===================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/txtTituloFiltros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtrar proveedores"
            android:textColor="@color/azulgourmeet"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="@font/caviardreams"/>

        <ImageView
            android:id="@+id/btnCerrarFiltros"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="7dp"
            android:src="@drawable/ic_cerrar_blanco"
            android:contentDescription="Cerrar filtros"
            app:tint="@color/azulgourmeet" />

    </LinearLayout>


    <!-- ===================================== -->
    <!-- CONTENIDO -->
    <!-- ===================================== -->

    <ScrollView
        android:id="@+id/scrollFiltros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">


            <!-- ===================================== -->
            <!-- DISTANCIA -->
            <!-- ===================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distancia"
                android:textColor="@color/azulgourmeet"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDistancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip0a5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0–5 km"
                    android:textSize="11sp"
                    android:fontFamily="@font/caviardreams"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip5a10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5–10 km"
                    android:fontFamily="@font/caviardreams"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip10a15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10–15 km"
                    android:fontFamily="@font/caviardreams"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip15mas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15+ km"
                    android:fontFamily="@font/caviardreams"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

            </com.google.android.material.chip.ChipGroup>


            <!-- ===================================== -->
            <!-- INGREDIENTES -->
            <!-- ===================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredientes"
                android:textColor="@color/azulgourmeet"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCarne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carne"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVerduras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verduras"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFrutas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frutas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLacteos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lácteos"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCereales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cereales"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLeguminosas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leguminosas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEspecias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Especias"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPastas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pastas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemillas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semillas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAbarrotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abarrotes"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLicores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Licores y destilados"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIndustrializados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Industrializados"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEmbutidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Embutidos"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHierbas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hierbas aromáticas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

            </com.google.android.material.chip.ChipGroup>


            <!-- ===================================== -->
            <!-- RECETAS -->
            <!-- ===================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recetas"
                android:textColor="@color/azulgourmeet"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRecetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:selectionRequired="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCocinaEspecialidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cocina de especialidad"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMariscos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mariscos"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPanaderia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panadería"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPostres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Postres"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCocinaGourmet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cocina gourmet"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegetariana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetariana"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCarnesSelectas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carnes selectas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDesayunos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desayunos"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAsiatica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asiática"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSnack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Snack"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCocteleria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coctelería y bebidas"
                    android:textSize="11sp"
                    android:checkable="true"
                    android:layout_margin="0dp"
                    android:backgroundTint="@color/chip_filtro_color"
                    android:textColor="@color/chip_filtro_texto"
                    app:chipMinTouchTargetSize="0dp"/>

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </ScrollView>


    <!-- ===================================== -->
    <!-- BOTONES -->
    <!-- ===================================== -->

    <LinearLayout
        android:id="@+id/guardaFiltros"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiarFiltros"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Limpiar"
            android:textColor="@color/azulgourmeet"
            android:textSize="13sp"
            app:cornerRadius="25dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="1dp"
            app:strokeColor="@color/azulgourmeet"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAplicarFiltros"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Aplicar"
            android:textSize="13sp"
            app:cornerRadius="25dp"
            app:backgroundTint="@color/azulgourmeet"/>

    </LinearLayout>

</LinearLayout>