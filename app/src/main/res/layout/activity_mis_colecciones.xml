<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <!--=====================================-->
    <!-- ENCABEZADO -->
    <!--=====================================-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerColecciones"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_rectangulo_azul_recto"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mis colecciones"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:gravity="center"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutNuevaColeccion"/>

        <LinearLayout
            android:id="@+id/layoutNuevaColeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imgNuevaColeccion"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_mas_blanco"
                app:tint="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:fontFamily="@font/caviardreams"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="colección"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:fontFamily="@font/caviardreams"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!--=====================================-->
    <!-- LISTA DE COLECCIONES -->
    <!--=====================================-->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerColecciones"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedorContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <!-- ================================= -->
            <!-- RECETAS REALIZADAS -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/txtTituloRecetasRealizadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:text="Recetas realizadas automaticamente"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecetasRealizadas"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="5dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"/>


            <!-- ================================= -->
            <!-- MIS COLECCIONES -->
            <!-- ================================= -->


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerColecciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                android:overScrollMode="never"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>