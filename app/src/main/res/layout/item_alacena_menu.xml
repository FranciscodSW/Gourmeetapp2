<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:background="@android:color/white">

    <!-- ICONO -->
    <ImageView
        android:id="@+id/imgIconoAlacena"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerInside"
        android:contentDescription="Icono de alacena"/>

    <!-- NOMBRE -->
    <TextView
        android:id="@+id/txtNombreAlacena"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Mi alacena"
        android:textColor="@color/azulgourmeet"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/caviardreams"/>

    <!-- EDITAR -->
    <ImageButton
        android:id="@+id/btnEditarAlacena"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_lapiz_editar"
        android:padding="12dp"
        android:contentDescription="Editar alacena"/>

    <!-- ELIMINAR -->
    <ImageButton
        android:id="@+id/btnEliminarAlacena"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_basura_azul"
        android:padding="12dp"
        android:contentDescription="Eliminar alacena"/>

</LinearLayout>