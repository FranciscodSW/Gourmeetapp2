<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    app:cardCornerRadius="22dp"
    app:cardElevation="8dp">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="22dp"

        android:background="@android:color/white">


        <!-- ================================= -->
        <!-- TÍTULO -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Cambiar nombre"
            android:textColor="@color/azulgourmeet"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"/>


        <!-- ================================= -->
        <!-- DESCRIPCIÓN -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="Escribe el nombre que quieres utilizar en GourMeet."
            android:textColor="#666666"
            android:textSize="14sp"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"/>


        <!-- ================================= -->
        <!-- CAMPO NOMBRE -->
        <!-- ================================= -->

        <com.google.android.material.textfield.TextInputLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:hint="Nuevo nombre"

            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/azulgourmeet">


            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/edtNuevoNombre"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="textCapWords"
                android:maxLength="50"

                android:singleLine="true"

                android:fontFamily="@font/caviardreams"/>

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================= -->
        <!-- BOTONES -->
        <!-- ================================= -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:orientation="horizontal">


            <!-- ============================= -->
            <!-- CANCELAR -->
            <!-- ============================= -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnCancelarNombre"

                android:layout_width="0dp"
                android:layout_height="50dp"

                android:layout_weight="1"

                android:layout_marginEnd="6dp"

                android:text="CANCELAR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"

                android:textColor="@color/azulgourmeet"

                app:backgroundTint="@android:color/white"

                app:strokeWidth="1dp"
                app:strokeColor="@color/azulgourmeet"

                app:cornerRadius="14dp"/>


            <!-- ============================= -->
            <!-- GUARDAR -->
            <!-- ============================= -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnGuardarNombre"

                android:layout_width="0dp"
                android:layout_height="50dp"

                android:layout_weight="1"

                android:layout_marginStart="6dp"

                android:text="GUARDAR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"

                android:textColor="@android:color/white"

                app:backgroundTint="@color/azulgourmeet"

                app:cornerRadius="14dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>