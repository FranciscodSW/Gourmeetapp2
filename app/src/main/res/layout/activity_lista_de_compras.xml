<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_rectangulo_azul_borde_negro_3"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Lista de compras"
                android:textColor="@color/white"
                android:fontFamily="@font/caviardreams"
                android:textSize="25sp"
                android:gravity="center_vertical"/>

        </LinearLayout>

        <!-- LISTA DE INGREDIENTES -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ingredientesfaltante"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"/>

        <!-- BOTONES INFERIORES -->
        <LinearLayout
            android:backgroundTint="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/btnAgregarAlacena"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:gravity="center"
                android:textColor="@color/azulgourmeet"
                android:fontFamily="@font/caviardreams"
                android:textSize="12sp"
                android:background="@drawable/bg_ovalo_sin_fondo"
                android:text="Agregar mis compras\n a la alacena"/>

            <TextView
                android:id="@+id/btnDescargarLista"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="Descargar lista\n de compras"
                android:textColor="@color/white"
                android:fontFamily="@font/caviardreams"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_ovalo_azul"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
