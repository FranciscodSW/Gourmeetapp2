<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">


    <!-- ================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerPremium"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_rectangulo_azul_borde_negro_3"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- BOTÓN REGRESAR -->

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:padding="10dp"
            android:src="@drawable/ic_cerrar_blanco"
            android:clickable="true"
            android:focusable="true"
            app:tint="@android:color/white"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloPremium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Planes GourMeet"
            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"

            app:layout_constraintStart_toEndOf="@id/btnRegresar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/seleccionar_plan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/headerPremium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtSeleccionaPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="18dp"

            android:text="Elige el plan ideal para ti"
            android:textColor="@color/azulgourmeet"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"/>


        <!-- SUBTÍTULO -->

        <TextView
            android:id="@+id/txtDescripcionPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="8dp"

            android:text="Descubre las opciones que GourMeet tiene para ti."
            android:textColor="#666666"
            android:textSize="14sp"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="450dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="350dp"
                android:src="@drawable/ic_plan_individual"
                />
            <Button
                android:id="@+id/btnComprarPlan"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/azulgourmeet"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:fontFamily="@font/caviardreams"
                android:text="Comprar"

                />
        </LinearLayout>
            <View
                android:layout_width="10dp"
                android:layout_height="0dp"/>
            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="450dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="350dp"
                    android:src="@drawable/ic_plan_familiar"
                    />
                <Button
                    android:id="@+id/btnComprarPlanHogar"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/azulgourmeet"
                    android:textColor="@color/white"
                    android:textSize="15dp"
                    android:fontFamily="@font/caviardreams"
                    android:text="Comprar"
                    />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>