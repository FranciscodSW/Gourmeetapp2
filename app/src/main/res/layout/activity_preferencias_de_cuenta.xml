<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">


    <!-- ========================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerCuenta"
        android:layout_width="0dp"
        android:layout_height="65dp"

        android:background="@color/azulgourmeet"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ===================================== -->
        <!-- REGRESAR -->
        <!-- ===================================== -->

        <ImageView
            android:id="@+id/btnRegresar"

            android:layout_width="45dp"
            android:layout_height="45dp"

            android:padding="10dp"

            android:src="@drawable/ic_flecha_izquierda"

            android:clickable="true"
            android:focusable="true"

            app:tint="@android:color/white"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <!-- ===================================== -->
        <!-- TÍTULO -->
        <!-- ===================================== -->

        <TextView
            android:id="@+id/txtTitulo"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:text="Preferencias de cuenta"

            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:textStyle="bold"

            android:fontFamily="@font/caviardreams"

            android:gravity="center"

            app:layout_constraintStart_toEndOf="@id/btnRegresar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================= -->
    <!-- CONTENIDO -->
    <!-- ========================================= -->

    <ScrollView
        android:id="@+id/scrollCuenta"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"

        android:overScrollMode="never"

        app:layout_constraintTop_toBottomOf="@id/headerCuenta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="18dp">


            <!-- ================================= -->
            <!-- PERFIL -->
            <!-- ================================= -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="18dp"

                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">


                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:gravity="center"

                    android:padding="20dp">


                    <ImageView
                        android:id="@+id/imgPerfil"

                        android:layout_width="90dp"
                        android:layout_height="90dp"

                        android:src="@drawable/logo_blanco_negro"

                        android:scaleType="centerCrop"

                        android:contentDescription="Foto de perfil"/>


                    <TextView
                        android:id="@+id/txtNombreUsuario"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="Francisco"

                        android:textColor="@color/azulgourmeet"

                        android:textSize="20sp"
                        android:textStyle="bold"

                        android:fontFamily="@font/caviardreams"/>


                    <TextView
                        android:id="@+id/txtCorreoUsuario"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="correo@ejemplo.com"

                        android:textColor="@android:color/darker_gray"

                        android:textSize="14sp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================= -->
            <!-- CUENTA -->
            <!-- ================================= -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="CUENTA"

                android:textColor="@color/azulgourmeet"

                android:textSize="14sp"

                android:textStyle="bold"

                android:fontFamily="@font/caviardreams"

                android:layout_marginBottom="8dp"/>


            <!-- EDITAR PERFIL -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditarPerfil"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="✏️  Editar información"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/black"/>


            <!-- CAMBIAR CORREO -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCambiarCorreo"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="📧  Cambiar correo electrónico"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/black"/>


            <!-- CAMBIAR CONTRASEÑA -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCambiarPassword"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="🔒  Cambiar contraseña"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/black"/>


            <!-- CAMBIAR TELÉFONO -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCambiarTelefono"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="📱  Cambiar teléfono"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/black"/>


            <!-- ================================= -->


            <!-- ================================= -->
            <!-- ZONA PELIGROSA -->
            <!-- ================================= -->



            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEliminarCuenta"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="🗑️  Eliminar cuenta"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/holo_red_dark"/>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>