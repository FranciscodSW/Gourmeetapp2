<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@android:color/white">
    <!-- ========================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerCuenta"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:background="@drawable/bg_rectangulo_azul_borde_negro_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- REGRESAR -->

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:padding="10dp"
            android:src="@drawable/ic_flecha_izquierda"
            android:clickable="true"
            android:focusable="true"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <!-- TÍTULO -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Preferencias de cuenta"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/btnRegresar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================= -->
    <!-- CONTENIDO -->
    <!-- ========================================= -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerCuenta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">


            <!-- ================================= -->
            <!-- CUENTA -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="CUENTA"

                android:textColor="@color/azulgourmeet"

                android:textSize="14sp"
                android:textStyle="bold"

                android:fontFamily="@font/caviardreams"

                android:layout_marginBottom="8dp"/>


            <!-- ================================= -->
            <!-- CAMBIAR NOMBRE -->
            <!-- ================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCambiarNombre"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="👤  Cambiar nombre de usuario"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/black"/>


            <!-- ================================= -->
            <!-- APARIENCIA -->
            <!-- ================================= -->





            <!-- ================================= -->
            <!-- INFORMACIÓN -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="INFORMACIÓN"

                android:textColor="@color/azulgourmeet"

                android:textSize="14sp"
                android:textStyle="bold"

                android:fontFamily="@font/caviardreams"

                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>


            <!-- ================================= -->
            <!-- TÉRMINOS -->
            <!-- ================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTerminosCondiciones"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="📄  Términos y condiciones"

                android:textAllCaps="false"

                android:gravity="start|center_vertical"

                android:paddingStart="18dp"

                android:background="@android:color/transparent"

                android:textColor="@android:color/black"/>


            <!-- ================================= -->
            <!-- PREMIUM -->
            <!-- ================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPremium"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:text="  Volverme Premium"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@color/azulgourmeet"
                    android:textColor="@android:color/white"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/btnReportarproblemas"
                android:layout_width="match_parent"
                android:layout_height="65dp"

                android:layout_marginTop="25dp"

                android:clickable="true"
                android:focusable="true"

                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/rojo">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:text="Reportar un problema"

                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"

                    android:fontFamily="@font/caviardreams"

                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>