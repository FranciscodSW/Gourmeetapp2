<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ================================================= -->
    <!-- ENCABEZADO -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerMihogar"
        android:layout_width="0dp"
        android:layout_height="65dp"

        android:background="@drawable/bg_rectangulo_azul_borde_negro_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTituloHogar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Editar miembros"
            android:textColor="@android:color/white"
            android:textSize="35sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ================================================= -->
    <!-- BUSCADOR -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/contenedorBuscador"
        android:layout_width="0dp"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/headerMihogar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- BUSCADOR -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- FONDO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ovalo_sin_fondo"
                android:gravity="center" />

            <!-- LUPA -->

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_lupa"
                android:translationZ="10dp"
                app:tint="@color/azulgourmeet" />

            <!-- TEXTO -->

            <EditText
                android:id="@+id/txtNombreusuariobuscar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="35dp"
                android:layout_marginEnd="5dp"
                android:background="@null"
                android:gravity="center"
                android:hint="Nombre o correo"
                android:inputType="text"
                android:textSize="12sp" />

        </FrameLayout>


        <!-- RESULTADOS DE BÚSQUEDA -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerUsuariosBusqueda"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="5dp"
            android:clipToPadding="false"
            android:visibility="gone" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- AGREGAR PERSONAS SIN CUENTA -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/targetagregarusuariosincuenta"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"

        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/azulgourmeet"
        app:strokeColor="@android:color/black"
        app:strokeWidth="1dp"

        app:layout_constraintTop_toBottomOf="@id/contenedorBuscador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- TÍTULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:text="Personas"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:gravity="center" />

            <!-- CONTENIDO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ovalo_sin_fondo"
                android:orientation="vertical"
                android:padding="5dp">

                <!-- TÍTULO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:text="Añadir personas sin cuenta GourMeet"
                    android:textColor="@color/azulgourmeet"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- NIÑOS -->

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Niños"
                        android:textColor="@color/azulgourmeet"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnMenosNinos"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@null"
                        android:contentDescription="Disminuir niños"
                        android:src="@drawable/ic_menos" />

                    <TextView
                        android:id="@+id/txtCantidadNinos"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/azulgourmeet"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnMasNinos"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@null"
                        android:contentDescription="Aumentar niños"
                        android:src="@drawable/ic_mas_azul" />

                </LinearLayout>


                <!-- ADULTOS -->

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Adultos"
                        android:textColor="@color/azulgourmeet"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnMenosAdultos"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@null"
                        android:contentDescription="Disminuir adultos"
                        android:src="@drawable/ic_menos" />

                    <TextView
                        android:id="@+id/txtCantidadAdultos"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/azulgourmeet"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnMasAdultos"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@null"
                        android:contentDescription="Aumentar adultos"
                        android:src="@drawable/ic_mas_azul" />

                </LinearLayout>


                <!-- ADULTOS MAYORES -->

                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Adultos mayores"
                        android:textColor="@color/azulgourmeet"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnMenosAdultosMayores"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@null"
                        android:contentDescription="Disminuir adultos mayores"
                        android:src="@drawable/ic_menos" />

                    <TextView
                        android:id="@+id/txtCantidadAdultosMayores"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/azulgourmeet"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnMasAdultosMayores"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@null"
                        android:contentDescription="Aumentar adultos mayores"
                        android:src="@drawable/ic_mas_azul" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- TÍTULO MIEMBROS -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/tituloMiembrosHogar"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:text="Miembros del hogar"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="@font/caviardreams"
        android:textColor="@color/azulgourmeet"

        app:layout_constraintTop_toBottomOf="@id/targetagregarusuariosincuenta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- MIEMBROS DEL HOGAR -->
    <!-- ================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/miembrosdelhogar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tituloMiembrosHogar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- ================================================= -->
    <!-- BOTONES -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/contenedorBotonesHogar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2"

        app:layout_constraintTop_toBottomOf="@id/miembrosdelhogar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- CANCELAR -->
        <Button
            android:id="@+id/btnCancelarMiembros"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="CANCELAR"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:textColor="@color/azulgourmeet"
            android:background="@drawable/bg_rectangulo_blanco"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />

        <!-- GUARDAR -->

        <Button
            android:id="@+id/btnGuardarMiembros"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="GUARDAR"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/azulgourmeet" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>