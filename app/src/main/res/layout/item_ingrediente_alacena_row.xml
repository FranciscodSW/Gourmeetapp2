<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="0dp" android:layout_marginBottom="8dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/white" app:strokeColor="@color/gm_border" app:strokeWidth="1dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:padding="14dp" android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:id="@+id/contenedorEmoji" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="12dp">
      <ImageView android:id="@+id/EmojiIngrediente" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerInside" android:src="@drawable/ic_ingredientes" android:importantForAccessibility="no" />
      <ImageView android:id="@+id/imgEstadoIngrediente" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|center_vertical" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:id="@+id/contenedorNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
        <TextView android:id="@+id/txtNombreIngrediente" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="15sp" android:textColor="@color/gm_ink" />
        <TextView android:id="@+id/txtCantidadIngrediente" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif" android:textSize="13sp" android:textColor="@color/gm_muted" />
      </LinearLayout>
      <TextView android:id="@+id/txtEstadoIngrediente" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/gm_accent" />
      <LinearLayout android:id="@+id/fechaconsumo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vence " android:textSize="12sp" android:textColor="@color/gm_muted" />
        <TextView android:id="@+id/txtFechadecompra" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/gm_muted" />
      </LinearLayout>
      <LinearLayout android:id="@+id/proximo_a_caducar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consume pronto" android:textSize="12sp" android:textColor="#865800" />
      </LinearLayout>
      <LinearLayout android:id="@+id/revisar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisar ingrediente" android:textSize="12sp" android:textColor="#A32929" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>