<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginTop="30dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">
        <!-- ================================================= -->
        <!-- ESPACIO BLANCO SUPERIOR -->
        <!-- ================================================= -->

        <View
            android:id="@+id/espacioSuperiorDetalle"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerDetalleProveedor"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:background="@drawable/bg_rectangulo_azul_borde_negro_3"
            android:clipChildren="false"
            android:clipToPadding="false"

            app:layout_constraintTop_toBottomOf="@id/espacioSuperiorDetalle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- X SOBRESALIENDO -->
            <ImageView
                android:id="@+id/btnCerrarDetalleProveedor"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:background="@drawable/bg_circulo_negro"
                android:src="@drawable/ic_cerrar_blanco"
                android:contentDescription="Cerrar"
                android:translationX="0dp"
                android:translationY="-25dp"
                android:elevation="30dp"
                android:translationZ="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/txtTituloDetalleProveedor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Proveedores cerca de ti"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:gravity="center"
                app:layout_constraintStart_toEndOf="@id/btnCerrarDetalleProveedor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================================================= -->
        <!-- PORTADA -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imgPortadaProveedor"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo_circular"

            app:layout_constraintTop_toBottomOf="@id/headerDetalleProveedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- ================================================= -->
        <!-- INFORMACIÓN SOBRE LA PORTADA -->
        <!-- ================================================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/infoSuperiorProveedor"

            android:layout_width="0dp"
            android:layout_height="55dp"

            android:background="@drawable/bg_rectangulo_azul_borde_negro_3"

            android:clipChildren="false"
            android:clipToPadding="false"

            app:layout_constraintTop_toBottomOf="@id/imgPortadaProveedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- ================================================= -->
            <!-- LOGO DEL PROVEEDOR -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogoProveedor"

                android:layout_width="78dp"
                android:layout_height="78dp"

                android:layout_marginStart="15dp"

                android:translationY="-25dp"

                app:cardCornerRadius="39dp"
                app:cardElevation="5dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgLogoProveedor"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:padding="3dp"

                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_logo_circular"/>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- DISTANCIA -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtDistanciaProveedor"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="18dp"

                android:text="A 4 km de distancia"

                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"

                android:fontFamily="@font/caviardreams"

                app:layout_constraintStart_toEndOf="@id/cardLogoProveedor"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>


            <!-- ================================================= -->
            <!-- HORARIO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtHorarioProveedor"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginEnd="12dp"
                android:layout_marginTop="5dp"

                android:text="Lun-Vie: 10:00 a 19:00 hrs"

                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:translationY="15dp"

                android:gravity="center"
                android:fontFamily="@font/caviardreams"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>




        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================================================= -->
        <!-- NOMBRE Y GIRO -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/infoNombreProveedor"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"

            app:layout_constraintTop_toBottomOf="@id/infoSuperiorProveedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:id="@+id/txtNombreProveedor"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="La Escondida"

                    android:textColor="@color/black"
                    android:textSize="19sp"
                    android:textStyle="bold"

                    android:fontFamily="@font/caviardreams"/>


                <TextView
                    android:id="@+id/txtGiroProveedor"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="7dp"

                    android:text="Carnicería"

                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold"

                    android:fontFamily="@font/caviardreams"/>

            </LinearLayout>


            <TextView
                android:id="@+id/txtDescripcionGiroProveedor"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Proveedor de ingredientes"

                android:textColor="@color/azulgourmeet"
                android:textSize="11sp"
                android:textStyle="bold"

                android:fontFamily="@font/caviardreams"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- REDES SOCIALES -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutRedesProveedor"

            android:layout_width="wrap_content"
            android:layout_height="45dp"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:layout_marginEnd="10dp"

            app:layout_constraintTop_toBottomOf="@id/infoNombreProveedor"
            app:layout_constraintEnd_toEndOf="parent">


            <ImageView
                android:id="@+id/btnWhatsappProveedor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="5dp"

                android:src="@drawable/ic_whatsapp"/>


            <ImageView
                android:id="@+id/btnTikTokProveedor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="5dp"
                android:src="@drawable/ic_tiktok"
                android:tint="@color/azulgourmeet"/>


            <ImageView
                android:id="@+id/btnInstagramProveedor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="5dp"
                android:src="@drawable/ic_instagram"
                />


            <ImageView
                android:id="@+id/btnFacebookProveedor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="5dp"
                android:src="@drawable/ic_facebook"/>

        </LinearLayout>
        <!-- ================================================= -->
        <!-- TÍTULO INFERIOR -->
        <!-- ================================================= -->

        <!-- ================================================= -->
        <!-- PESTAÑAS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutTabsProveedor"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:layout_marginTop="5dp"

            app:layout_constraintTop_toBottomOf="@id/layoutRedesProveedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProductosProveedor"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Productos"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:textColor="@color/white"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/azulgourmeet"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGaleriaProveedor"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:text="Galería"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:textColor="@color/azulgourmeet"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/azulgourmeet"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapaProveedor"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Mapa"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/caviardreams"
                android:textColor="@color/azulgourmeet"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/azulgourmeet"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TÍTULO DINÁMICO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtQueOfrece"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"
            android:paddingHorizontal="25dp"

            android:text="¿Qué te ofrece este proveedor?"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caviardreams"

            app:layout_constraintTop_toBottomOf="@id/layoutTabsProveedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        <FrameLayout
            android:id="@+id/containerContenidoProveedor"

            android:layout_width="0dp"
            android:layout_height="350dp"

            android:layout_marginTop="10dp"

            app:layout_constraintTop_toBottomOf="@id/txtQueOfrece"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- PRODUCTOS -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductosProveedor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="true"/>


            <!-- GALERÍA -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGaleriaProveedor"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:visibility="gone"
                android:padding="8dp"/>


            <!-- MAPA -->

            <fragment
                android:id="@+id/mapProveedor"

                android:name="com.google.android.gms.maps.SupportMapFragment"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:visibility="gone"/>

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>