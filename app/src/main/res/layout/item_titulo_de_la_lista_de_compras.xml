<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iconodecategoria"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_plato_fuerte"
            android:gravity="center_vertical"/>
        <View
            android:layout_width="35dp"
            android:layout_height="25dp"/>
        <TextView
            android:id="@+id/nombredelacategoriadecompra"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:text="Frutas y verduras"
            android:fontFamily="@font/caviardreams"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            />
        <View
            android:layout_width="35dp"
            android:layout_height="25dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:text="ver provedores"
            android:textColor="@color/white"
            android:textSize="15dp"
            android:background="@drawable/bg_ovalo_azul"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listadefaltante"
        android:layout_width="409dp"
        android:layout_height="165dp"
        tools:layout_editor_absoluteX="2dp"
        tools:layout_editor_absoluteY="29dp" />

</androidx.constraintlayout.widget.ConstraintLayout>