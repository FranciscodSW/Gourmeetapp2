<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Ventana principal -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSinInternet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Imagen: ocupa el espacio disponible -->
            <ImageView
                android:id="@+id/ivSinInternet"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/sin_conexion_a_internet"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Michi de GourMeet sin conexión a internet"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnReintentarInternet"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botón para reintentar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarInternet"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/caviardreams"
                android:text="Reintentar"
                android:textSize="19sp"
                android:textColor="@android:color/white"
                android:contentDescription="Reintentar conexión"
                app:backgroundTint="#177AFF"
                app:cornerRadius="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

