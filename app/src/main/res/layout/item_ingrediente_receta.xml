    <ImageView android:id="@+id/imgIngrediente" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp" android:scaleType="centerInside" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/txtIngrediente" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/gm_ink" android:textSize="15sp"/>
    <TextView android:id="@+id/txtcantidad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="112dp" android:layout_marginStart="12dp" android:fontFamily="sans-serif" android:gravity="end" android:textColor="@color/gm_muted" android:textSize="14sp"/>
</LinearLayout>
