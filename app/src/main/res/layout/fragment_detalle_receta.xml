<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="1dp"
    android:background="@android:color/white"
    android:paddingBottom="200dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- CardView para información principal de la receta -->
        <androidx.cardview.widget.CardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_margin="1dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <!-- Imagen de fondo -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="top"
                    android:background="@drawable/degradado_negro_superior"/>
                <ImageView
                    android:id="@+id/imgHeaderReceta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <!-- contenido -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <!-- ========================= -->
                    <!-- PANEL SUPERIOR IZQUIERDO  -->
                    <!-- ========================= -->
                    <LinearLayout
                        android:id="@+id/layoutDatos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- Tiempo -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_clock_bg"/>

                            <TextView
                                android:id="@+id/txtTiempo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50 min"
                                android:textColor="@android:color/black"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/caviardreams"/>

                        </LinearLayout>

                        <!-- Nivel -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_gorrito_nuevo_azul"/>
                            <TextView
                                android:id="@+id/txtNivel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fácil"
                                android:textColor="@android:color/black"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/caviardreams"/>
                        </LinearLayout>

                        <!-- Precio -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_dinero"/>

                            <TextView
                                android:id="@+id/txtCosto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$49"
                                android:textColor="@android:color/black"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/caviardreams"/>

                        </LinearLayout>

                        <!-- Tipo -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_comida"/>

                            <TextView
                                android:id="@+id/txtTipo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plato fuerte"
                                android:textColor="@android:color/black"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/caviardreams"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ========================= -->
                    <!-- TITULO                    -->
                    <!-- ========================= -->

                    <com.example.gourmeet2.views.StrokeTextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Enchiladas Verdes"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- ========================= -->
                    <!-- COINCIDENCIA              -->
                    <!-- ========================= -->

                    <com.example.gourmeet2.views.BlueStrokeTextView
                        android:id="@+id/txtCoincidencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coincidencia: 35%"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/caviardreams"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTitulo"/>

                    <!-- ========================= -->
                    <!-- CALIFICACION              -->
                    <!-- ========================= -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/txtCalificacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caviardreams"
                            android:text="4.0"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <RatingBar
                            android:id="@+id/ratingReceta"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="1"
                            android:rating="0"
                            android:isIndicator="false"
                            android:progressTint="#177AFF"
                            android:secondaryProgressTint="#177AFF"
                            android:progressBackgroundTint="#D6D6D6"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <!-- PANEL DATO GOURMEET -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_panel_receta"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dato GourMeet"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="@font/caviardreams"/>

                <TextView
                    android:id="@+id/tvDatoGourmet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="30 g de proteína"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:fontFamily="@font/caviardreams"/>

            </LinearLayout>

            <!-- PANEL DESCRIPCIÓN -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_panel_receta_derecha"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="@font/caviardreams"/>
                <TextView
                    android:id="@+id/tvRecetaDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxLines="7"
                    android:ellipsize="end"
                    android:text="Descripción de la receta..."
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:fontFamily="@font/caviardreams"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Ingredientes"
                android:textStyle="bold"
                android:textSize="22sp"
                android:fontFamily="@font/caviardreams"
                android:textColor="#222"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIngredientes"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="18dp"
                android:overScrollMode="never"
                android:scrollbars="horizontal"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPreparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            app:cardBackgroundColor="#177AFF"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <!-- Cabecera con título y contador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Preparación"
                        android:fontFamily="@font/caviardreams"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnParlante"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="0dp"
                        android:backgroundTint="#177AFF"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_audio_on"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@android:color/white"/>
                </LinearLayout>
                <!-- Área para mostrar el paso actual -->
                <LinearLayout
                    android:id="@+id/containerPasoActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_paso"
                    >
                        <TextView
                            android:id="@+id/tvDescripcionPaso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aquí aparecerá el paso"
                            android:textSize="18sp"
                            android:textColor="#333333"
                            android:gravity="center"
                            android:fontFamily="@font/caviardreams"
                            android:lineSpacingExtra="5dp"/>
                    <!-- Barra de progreso -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:layoutDirection="rtl">
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/containerIndicadores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal"/>
                    <LinearLayout
                        android:id="@+id/layoutControlesPreparacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- IZQUIERDA -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerTodo"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="Ver todo"
                            app:iconGravity="textStart"
                            android:textAllCaps="false"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#177AFF"
                            app:cornerRadius="22dp"/>

                        <!-- ESPACIO FLEXIBLE -->
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <!-- CENTRO -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVoz"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:backgroundTint="#177AFF"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_microfono"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white"/>

                        <!-- ESPACIO FLEXIBLE -->
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <!-- DERECHA -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAnterior"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:backgroundTint="#177AFF"
                                app:cornerRadius="24dp"
                                app:icon="@drawable/ic_flecha_izquierda"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@android:color/white"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSiguiente"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="#177AFF"
                                app:cornerRadius="24dp"
                                app:icon="@drawable/ic_flecha_derecha"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@android:color/white"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerTodosLosPasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:fontFamily="@font/caviardreams"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">
                <!-- 🔥 Miniatura -->
                <ImageView
                    android:id="@+id/imgPreviewVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <!-- 🔥 Ícono Play -->
                <ImageView
                    android:id="@+id/imgPlay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_youtube"
                    android:alpha="0.9"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportarProblema"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Reportar"
                    android:backgroundTint="#D9593F"
                    app:cornerRadius="22dp"/>
                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecetaTerminada"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Terminada"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:backgroundTint="#177AFF"
                    app:cornerRadius="22dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Encabezado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgUsuarioComentario"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_user"
                        android:scaleType="centerCrop"
                        android:padding="2dp"/>
                    <EditText
                        android:id="@+id/editComentario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="¿Qué te pareció esta receta?"
                        android:textColor="#333333"
                        android:textColorHint="#A0A0A0"
                        android:textSize="16sp"
                        android:maxLength="150"
                        android:minLines="1"
                        android:maxLines="3"
                        android:gravity="center_vertical"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences|textMultiLine"/>
                </LinearLayout>
                <!-- Estrellas + botón -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">
                    <RatingBar
                        android:id="@+id/ratingComentario"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="0"
                        android:isIndicator="false"
                        android:progressTint="#177AFF"
                        android:secondaryProgressTint="#177AFF"
                        android:progressBackgroundTint="#D6D6D6"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnComentar"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Comentar"
                        android:enabled="false"
                        android:alpha="0.5"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#177AFF"
                        app:cornerRadius="20dp"/>
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E6E6E6"/>

                <!-- Ver comentarios -->
                <LinearLayout
                    android:id="@+id/layoutVerComentarios"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerComentarios"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Comentarios anteriores"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="#177AFF"
                        android:backgroundTint="@android:color/white"
                        app:strokeColor="#177AFF"
                        app:strokeWidth="2dp"
                        app:cornerRadius="20dp"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardComplementar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardUseCompatPadding="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Completa tu comida"
                android:fontFamily="@font/caviardreams"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMasFunciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Más funciones de GourMeet para ti"
                    android:textColor="#212121"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/caviardreams"/>
                <!-- Espacio -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="18dp"/>
                <!-- Opciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <!-- Guardar colección -->
                    <LinearLayout
                        android:id="@+id/layoutColeccion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
