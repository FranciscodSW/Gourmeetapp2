<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">
    <!-- ================================= -->
    <!-- TÍTULO -->
    <!-- ================================= -->
    <TextView
        android:id="@+id/txtTituloProveedores"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:text="Nuestros proveedores para ti"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/caviardreams"
        android:gravity="center"
        android:background="@drawable/bg_rectangulo_azul_borde_negro_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ================================= -->
    <!-- CONTENEDOR DE ACCIONES -->
    <!-- ================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorAccionesProveedor"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:background="@drawable/bg_rectangulo_azul_borde_negro_3"
        app:layout_constraintTop_toBottomOf="@id/txtTituloProveedores"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- ================================= -->
        <!-- 🔎 BUSCAR -->
        <!-- ================================= -->
        <LinearLayout
            android:id="@+id/contenedorBuscarProveedor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/contenedorUbicacionProveedor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/btnbuscar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="0dp"
                android:src="@drawable/ic_lupa"
                android:clickable="false"
                android:focusable="false"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/txtBuscarProveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="@font/caviardreams"
                android:gravity="center"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- ================================= -->
        <!-- 📍 UBICACIÓN -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/contenedorUbicacionProveedor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintStart_toEndOf="@id/contenedorBuscarProveedor"
            app:layout_constraintEnd_toStartOf="@id/contenedorColeccionesProveedor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/btnubicaion"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="0dp"
                android:src="@drawable/ic_ubicacion"
                android:clickable="false"
                android:focusable="false"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/txtUbicacionProveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mapa de proveedores"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="@font/caviardreams"
                android:gravity="center"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- ================================= -->
        <!-- 💾 MIS COLECCIONES -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/contenedorColeccionesProveedor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintStart_toEndOf="@id/contenedorUbicacionProveedor"
            app:layout_constraintEnd_toStartOf="@id/contenedorFiltrosProveedor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/btnmiscoleccionesprovedor"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="0dp"
                android:src="@drawable/ic_guardar"
                android:clickable="false"
                android:focusable="false"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/txtMisColeccionesProveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Mis Colecciones"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="@font/caviardreams"
                android:gravity="center"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- ================================= -->
        <!-- ⚙ FILTROS -->
        <!-- ================================= -->

        <LinearLayout
            android:id="@+id/contenedorFiltrosProveedor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"

            app:layout_constraintStart_toEndOf="@id/contenedorColeccionesProveedor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <ImageView
                android:id="@+id/btnfiltros"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="0dp"
                android:src="@drawable/ic_filtro"
                android:clickable="false"
                android:focusable="false"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/txtFiltrosProveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtros"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="@font/caviardreams"
                android:gravity="center"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- ================================= -->
        <!-- 🔎 BARRA DE BÚSQUEDA -->
        <!-- ================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutBusquedaProveedor"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="75dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:translationX="-500dp"
            app:cardCornerRadius="21dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <EditText
                android:id="@+id/edtBuscarProveedor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Buscar proveedor..."
                android:singleLine="true"
                android:paddingHorizontal="15dp"
                android:textSize="13sp"
                android:fontFamily="@font/caviardreams"/>

        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>