<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:padding="20dp"
    android:background="@android:color/white">


    <!-- ========================================== -->
    <!-- IMAGEN -->
    <!-- ========================================== -->

    <ImageView
        android:id="@+id/imgPermisoUbicacion"

        android:layout_width="380dp"
        android:layout_height="550dp"

        android:src="@drawable/ic_permisos_de_ubicacion"

        android:scaleType="fitCenter"

        android:contentDescription="Permiso de ubicación"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>




    <!-- ========================================== -->
    <!-- DESCRIPCIÓN -->
    <!-- ========================================== -->



    <!-- ========================================== -->
    <!-- BOTÓN PERMITIR -->
    <!-- ========================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPermitirUbicacion"

        android:layout_width="0dp"
        android:layout_height="52dp"

        android:layout_marginTop="20dp"

        android:text="Permitir ubicación"

        android:textColor="@android:color/white"

        android:textSize="15sp"

        android:textStyle="bold"

        android:fontFamily="@font/caviardreams"

        app:backgroundTint="@color/azulgourmeet"

        app:cornerRadius="15dp"

        app:layout_constraintTop_toBottomOf="@id/imgPermisoUbicacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ========================================== -->
    <!-- BOTÓN CANCELAR -->
    <!-- ========================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarUbicacion"

        android:layout_width="0dp"
        android:layout_height="52dp"

        android:layout_marginTop="8dp"

        android:text="Ahora no"

        android:textColor="@color/azulgourmeet"

        android:textSize="15sp"

        android:fontFamily="@font/caviardreams"

        android:backgroundTint="@android:color/white"

        app:strokeColor="@color/azulgourmeet"

        app:strokeWidth="1dp"

        app:cornerRadius="15dp"

        app:layout_constraintTop_toBottomOf="@id/btnPermitirUbicacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>